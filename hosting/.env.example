# Templates only. Configure privately; never commit a filled-in copy.
APP_ORIGIN=https://your-reprolab-domain.example
TURSO_DATABASE_URL=libsql://your-dedicated-libsql-database.turso.io
TURSO_AUTH_TOKEN=replace-with-a-server-only-database-token
REPRO_ALLOW_REGISTRATION=0
# Optional initialization-only variables. Do not keep the owner password in Vercel:
# REPRO_MIGRATION_CONFIRM=INITIALIZE_REPROLAB
# REPRO_OWNER_EMAIL=operator@example.org
# REPRO_OWNER_NAME=Operator
# REPRO_OWNER_PASSWORD=use-a-unique-long-password
