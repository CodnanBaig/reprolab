# Copy to .env; npm start/dev/start:built load it automatically.
# Shell environment variables override file values.
PORT=4318
HOST=127.0.0.1
APP_ORIGIN=http://localhost:4318
DATABASE_PATH=.data/reprolab.sqlite
RETENTION_DAYS=14
# Required behind an HTTPS reverse proxy. Keep 0 only for loopback HTTP.
COOKIE_SECURE=0
# Optional, server-only token for explicitly confirmed GitHub issue creation.
# Never put this in the SDK, extension or client bundle.
GITHUB_TOKEN=

# Comma-separated exact owner/repository allowlist; required with GITHUB_TOKEN.
GITHUB_ALLOWED_REPOS=
